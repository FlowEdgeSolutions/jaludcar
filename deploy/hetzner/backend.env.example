NODE_ENV=production
PORT=3000

# Local PostgreSQL on the Hetzner server.
DATABASE_URL=postgresql://jalud:CHANGE_ME@127.0.0.1:5432/jalud
DB_SSL=false
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
ADMIN_EMAIL=admin@jalud.de
ADMIN_PASSWORD=CHANGE_ME

# Keep uploads outside the git checkout so deployments do not delete images.
UPLOADS_DIR=/var/www/jalud/shared/uploads

# Optional: needed only for AI blog generation.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Contact-form email delivery with Resend.
RESEND_API_KEY=
RESEND_FROM=JALUD Premium Autopflege <info@jalud.de>
RESEND_TO=info@jalud.de
RESEND_REPLY_TO=

# Optional: lead generation in the Admin area.
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
JALUD_LEAD_CENTER_LAT=51.41109
JALUD_LEAD_CENTER_LNG=7.19951
JALUD_LEAD_RADIUS_METERS=15000
