# Admin Zugriff
ADMIN_EMAIL=admin@jalud.de
ADMIN_PASSWORD=bitte_ein_starkes_passwort_setzen
JWT_SECRET=bitte_ein_langes_geheimes_passwort_setzen

# PostgreSQL (Railway)
DATABASE_URL=postgresql://user:password@host:port/db
DB_SSL=true

# Uploads volume (Railway Volume mount path)
UPLOADS_DIR=/data/uploads

# Server Port
PORT=3000

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Email Configuration (STRATO SMTP)
EMAIL_HOST=smtp.strato.de
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@jalud.de
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=JALUD Premium Autopflege <info@jalud.de>
EMAIL_ADMIN=info@jalud.de
