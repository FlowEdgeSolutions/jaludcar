{
  "buildCommand": "cd frontend && npm install && npm run build:vercel",
  "outputDirectory": "frontend/dist/flowedge-app/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.jalud.de/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.jalud.de/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
